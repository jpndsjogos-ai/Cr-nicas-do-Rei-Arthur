; Engine configuration file.
; Este arquivo é normalmente editado pela interface do Godot,
; mas pode ser versionado e editado manualmente sem problemas.

config_version=5

[application]

config/name="Round Table Chronicles"
config/description="Beat 'em up medieval original, inspirado na jogabilidade clássica de brawlers 16-bit, com sistema de evolução visual de armaduras e armas."
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://icon.svg"

[autoload]

GameManager="*res://scripts/autoload/GameManager.gd"
UpgradeSystem="*res://scripts/autoload/UpgradeSystem.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/handheld/orientation="landscape"
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

